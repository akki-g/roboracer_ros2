// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
  "name": "ROS Environment INTEL",
  "build": {
    "dockerfile": "../../Dockerfile",
    "target": "dev"
  },
  // 1. Mount the Wayland Socket and GPU rendering devices consistency=cached
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  "runArgs": [
    "--ipc=host",
    "--network=host",
    "--device=/dev/dri:/dev/dri"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "remoteEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "initializeCommand": "xhost +local:docker",
  "privileged": true,
  "appPort": 8765,
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "version": "latest",
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "latest"
    }
  },
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "Ranch-Hand-Robotics.rde-ros-2",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "ms-vscode.cpptools",
        "ms-vscode.cpp-devtools",
        "magicstack.MagicPython",
        "ms-python.black-formatter",
        "KevinRose.vsc-python-indent"
      ]
    }
  }
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
